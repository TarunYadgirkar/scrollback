// Copy to Config/Secrets.xcconfig (gitignored) and fill in your own values.
// Your Team ID is under Membership details at https://developer.apple.com/account
DEVELOPMENT_TEAM = ABCDE12345
// A reverse-DNS prefix you control. The apps become <prefix>.scrollback, <prefix>.scrollback.macos
// and so on, with iCloud container iCloud.<prefix>.scrollback and App Group group.<prefix>.scrollback.
BUNDLE_ID_PREFIX = com.yourname
