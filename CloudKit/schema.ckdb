// Schema for iCloud.com.example.scrollback. Load it with scripts/cloudkit-schema.sh,
// then deploy it to Production in CloudKit Console. Every build uses Production.
DEFINE SCHEMA

    // One UTC day of the Mac's history, written only by the Mac. Record name: day-<days since 1970>.
    RECORD TYPE HistoryDay (
        "___recordID" REFERENCE QUERYABLE,
        payload ENCRYPTED BYTES,
        version ENCRYPTED INT64,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE,
        roles LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
